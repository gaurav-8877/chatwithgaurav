# ─────────────────────────────────────────────────────────────────────────────
# Set ALL of these in the Render backend service dashboard → Environment
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<dbname>

# JWT — use a long random string in prod
JWT_SECRET=change_me_to_a_long_random_string

# Your Render FRONTEND service URL (no trailing slash)
# e.g. https://chatwithgaurav-frontend.onrender.com
CLIENT_URL=https://YOUR-FRONTEND-NAME.onrender.com

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (for welcome emails)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Chatify

# Arcjet (rate limiting)
ARCJET_KEY=
ARCJET_ENV=production
